# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Output APKs and signatures
output/
*.apk
*.idsig
*.zip

# Savegame Backups (contain player proprietary progress)
backups/
backups/*.json

# Keystores & keys (auto-generated by keytool on first build)
keystore/
*.jks
*.keystore

# Source APKs and proprietary binary assets (user-supplied)
source/
*.apk
*.so
*.dex
*.dat

# Downloaded toolchain jars (apktool is fetched on first use)
tools/*.jar

# Temporary & intermediate work directories
.fwt_work_*
*.tmp
*.log

# Python tooling / virtual environments
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
uv.lock

# Local environment configuration (contains local paths and secrets)
.env
.env.*
!.env.example

# Local secrets / recovered cipher material
*.local.json
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
certs/

# Local analysis/repair scratch directories
.acl-recovery/
.tools/
analysis_tmp/
pytest-of-*/
.coverage
.coverage.*
htmlcov/


# Local editor/agent/IDE/harness/workflow state (never commit)
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/fwt-*/
.specify/*
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md
specs/
.commandcode/
.codex-attachments/
.gemini/
.claude/
.cursor/
.vscode/
.idea/
artifacts/
scratch/

# OS and editor backup artifacts
*.bak
*.orig
*.swp
*~
Thumbs.db
.DS_Store
