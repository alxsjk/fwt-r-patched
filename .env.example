# FWT Re-Patched local configuration
# Copy to .env and adjust. .env is ignored by git.

# Debug tracebacks for CLI errors
FWT_DEBUG=1

# Android SDK / Java (used by zipalign/apksigner)
ANDROID_HOME=C:\Users\YOUR_USER\android-sdk
# JAVA_HOME=C:\Program Files\Java\jdk-21

# ADB target used when --device is omitted
FWT_DEVICE=192.0.2.10:5555

# Signing keystore (created automatically on first build if absent)
FWT_KEYSTORE=keystore/fwt_reborn_lan.jks
FWT_KEY_ALIAS=fwtreborn
FWT_KEYSTORE_PASS=android

# Default APK paths
FWT_SOURCE_APK=source/fwt_0.682_offline_v1574.apk
FWT_OUTPUT_APK=output/FWT-Reborn-Patched.apk

# Recovered network handshake cipher (from private reverse-engineering research)
# AES-256-CBC + PKCS#7, Base64, raw DEFLATE (wbits=-15)
FWT_NETWORK_CRYPT_KEY=CHANGE_ME_32_BYTES
FWT_NETWORK_CRYPT_IV=CHANGE_ME_16_BYTES

# Client datatable / local-cache cipher
# FWT_DATATABLE_CRYPT_KEY and FWT_DATATABLE_CRYPT_IV are required to decrypt/re-encrypt client UnityFS datatables
FWT_DATATABLE_CRYPT_KEY=CHANGE_ME_32_BYTES
FWT_DATATABLE_CRYPT_IV=CHANGE_ME_16_BYTES
FWT_DATATABLE_CRYPT_KEY_REVERSED=CHANGE_ME_32_BYTES
FWT_DATATABLE_CRYPT_IV_REVERSED=CHANGE_ME_16_BYTES
FWT_CACHE_CRYPT_KEY=CHANGE_ME_32_BYTES
FWT_CACHE_CRYPT_IV=CHANGE_ME_16_BYTES

# SecureDataManager ID keys
FWT_ID_KEY_START=CHANGE_ME
FWT_ID_KEY_END=CHANGE_ME

# Linux build server SSH access (local .env only)
# FWT_SSH_HOST=YOUR_USER@your-linux-host
# FWT_SSH_REPO_PATH=/path/to/fwt-r-patched
